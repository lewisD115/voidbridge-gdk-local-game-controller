{
	"name": "GDK Local Game Controller",
	"version": "0.1.0",
	"description": "Ignore/acknowledge gameConfigContentRoot value or switch device client with a click! Use the shortkey Command+Shift+K/Ctr+Shift+k to show the controller.",
	"permissions": ["tabs", "storage"],
	"host_permissions": ["https://*.vbgames88.com/play/portals/*"],
	"content_scripts": [
		{
			"matches": ["https://*.vbgames88.com/play/portals/*"],
			"js": ["contentScript.js"]	
		}
	],
	"action": {
		"default_icon": {
			"16": "assets/voidbridgeLogo.png",
			"24": "assets/voidbridgeLogo.png",
			"32": "assets/voidbridgeLogo.png"
		},
		"default_popup": "popup.html"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+K",
				"mac": "Command+Shift+K"
			}
		}
	},
    "manifest_version": 3,
    "web_accessible_resources": [
	    {
	        "resources": ["inject.js"],
	        "matches": ["https://*.vbgames88.com/*"]
	    }
	]

}